# Firefox source checkout (fetched by scripts/01-fetch-source.ps1)
/firefox-src/

# Build object dir (also created inside firefox-src per mozconfig)
/obj-sanctum/
**/obj-sanctum/

# Packaged output
/dist/

# OS / editor noise
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~
