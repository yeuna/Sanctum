# -----------------------------------------------------------------------------
#  CI-only mozconfig fragment (appended to .mozconfig by the GitHub workflow).
#  Do NOT use locally unless you have sccache installed — it speeds up CI by
#  caching compiled objects across runs. It contains NOTHING that affects the
#  privacy guarantees; it only changes how the compiler is invoked.
# -----------------------------------------------------------------------------
# NOTE: the ccache/rustc-wrapper lines that point at sccache are written by the
# "Enable sccache in the build config" workflow step, which resolves the ABSOLUTE
# sccache path from $SCCACHE_PATH:
#     ac_add_options --with-ccache=<abs path>
#     mk_add_options "export RUSTC_WRAPPER=<abs path>"
# Passing the bare name "sccache" makes configure look under
# .mozbuild\sccache\sccache.exe (never populated) and die, so don't set it here.

# The mozilla-actions/sccache-action sets SCCACHE_GHA_ENABLED + ACTIONS_* tokens
# in the environment; this makes the GitHub Actions cache the sccache backend.
mk_add_options "export CARGO_INCREMENTAL=0"

# Let configure use the mach-bootstrapped toolchains under MOZBUILD_STATE_PATH.
# mach bootstrap ships rust as a dist-toolchain artifact (it does NOT install
# rustup), and configure only extracts/uses it with bootstrap enabled — without
# this it searches just PATH and ~/.cargo/bin and dies "Rust compiler not found"
# (the runner service account has no rustup).
ac_add_options --enable-bootstrap
