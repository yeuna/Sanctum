with Files("**"):
    BUG_COMPONENT = ("Sanctum", "Branding")

# The window/taskbar icon PNGs (default*.png) and the .ico files in this
# directory are consumed directly by browser/app and browser/installer via the
# configured branding path (--with-branding=browser/branding/sanctum); they do
# not need to be listed here. We only descend into the packaged sub-pieces.
DIRS += [
    "content",
    "locales",
]
