JAR_MANIFESTS += ["jar.mn"]

# The Fluent brand bundle (brand.ftl) is delivered through the localization
# system rather than the JAR, mirroring upstream Firefox.
FINAL_TARGET_FILES.localization["branding"] += ["en-US/brand.ftl"]
