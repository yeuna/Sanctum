#filter substitution
# This Source Code Form is subject to the terms of the Mozilla Public
# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at http://mozilla.org/MPL/2.0/.

# The `#filter substitution` line above is REQUIRED: it makes the preprocessor
# expand @AB_CD@ (the locale, e.g. en-US) before jar.py parses the manifest.
# Without it the literal "@AB_CD@.jar:" reaches the parser, whose jarfile regex
# forbids '@', and config_status aborts with RuntimeError. Sanctum ships en-US
# only; brand.ftl is delivered via locales/moz.build (FINAL_TARGET_FILES).
@AB_CD@.jar:
% locale branding @AB_CD@ %locale/branding/
  locale/branding/brand.dtd         (en-US/brand.dtd)
  locale/branding/brand.properties  (en-US/brand.properties)
